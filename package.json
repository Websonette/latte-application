{
  "name": "@websonette/latte-application",
  "version": "0.1.0",
  "description": "Browser runtime and Vite integration for server-rendered Websonette applications using Nette and Latte.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/frontend/index.d.ts",
      "import": "./dist/frontend/index.js"
    },
    "./naja": {
      "types": "./dist/frontend/naja/index.d.ts",
      "import": "./dist/frontend/naja/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./vite/client": {
      "types": "./dist/vite/client.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-client-types.mjs",
    "typecheck": "tsc --noEmit",
    "tests": "vitest run",
    "test": "npm run typecheck && npm run tests && npm run build"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "happy-dom": "^20.11.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5"
}

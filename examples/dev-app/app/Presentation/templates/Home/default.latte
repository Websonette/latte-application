<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Websonette Latte Application</title>
    <style>
        body { max-width: 52rem; margin: 3rem auto; padding: 0 1rem; font: 16px/1.5 system-ui, sans-serif; }
        code { background: #f1f3f5; padding: .15rem .35rem; }
        .flash { margin: 1rem 0; padding: .75rem 1rem; border-radius: .35rem; background: #e7f5ff; }
        .flash-success { background: #d3f9d8; }
    </style>
</head>
<body>
    <h1>Latte Application development app</h1>

    {control breadcrumbs}

    <div n:foreach="$flashes as $flash" class="flash flash-{$flash->type}">
        {$flash->message}
    </div>

    <p>{_'websonette.latte-application.flash.success'}</p>

    <p>The example consumes the released package from Packagist.</p>

    <ul>
        <li>Bootstrap: <code>{$packageBootstrap}</code></li>
        <li>Base presenter: <code>{$packagePresenter}</code></li>
    </ul>

    <p><a n:href="showFlash!">Create a typed success flash message</a></p>
</body>
</html>
